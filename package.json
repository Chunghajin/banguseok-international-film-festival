{
  "name": "banguseok-international-film-festival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "verify:g2": "node --conditions=react-server --env-file-if-exists=.env.local scripts/g2/verify.mjs",
    "verify:g2:secrets": "node --env-file-if-exists=.env.local scripts/g2/check-secrets.mjs",
    "verify:g3": "node scripts/g3/verify.mjs",
    "verify:m1": "node scripts/m1/check-http.mjs",
    "verify:g1": "node --env-file-if-exists=.env.local scripts/g1/verify.mjs",
    "verify:m2:catalog": "node --conditions=react-server --env-file-if-exists=.env.local scripts/m2/verify-catalog.mjs",
    "verify:m2:http": "node --env-file-if-exists=.env.local scripts/m2/check-http.mjs",
    "verify:m2:browser": "node scripts/m2/browser.mjs",
    "verify:m3:browser": "node scripts/m3/browser.mjs",
    "verify:m4": "node --env-file-if-exists=.env.local scripts/m4/verify.mjs",
    "verify:m4:browser": "node --env-file-if-exists=.env.local scripts/m4/browser.mjs",
    "verify:m5:readiness": "node --env-file-if-exists=.env.local scripts/m5/readiness.mjs",
    "verify:m5": "node --conditions=react-server --env-file-if-exists=.env.local scripts/m5/verify.mjs",
    "verify:m5:preview": "node --conditions=react-server --env-file-if-exists=.env.local scripts/m5/preview-verify.mjs",
    "verify:m5:browser": "M5_UI_CHECK=yes node --env-file-if-exists=.env.local scripts/m4/browser.mjs",
    "verify:m5:http": "node --env-file-if-exists=.env.local scripts/m5/check-http.mjs",
    "verify:m5:replay": "node --env-file-if-exists=.env.local scripts/m5/replay-diagnostic.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
